{
  "permissions": {
    "allow": [
      "Bash({{CHECK_CMD}})",
      "Bash({{SHOTS_CMD}}*)",
      "Bash({{DEV_CMD}}*)",
      "Bash({{BUILD_CMD}})",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b*)",
      "Bash(git worktree*)",
      "Bash(git symbolic-ref*)",
      "Bash(gh repo view*)",
      "Bash(gh api repos/*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr create*)",
      "Bash(rsync*)",
      "Bash(scp*)",
      "Bash(ssh*)",
      "Bash(rm -rf*)"
    ]
  }
}
